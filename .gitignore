# 依赖与缓存（不入库）
.venv/
__pycache__/
*.pyc
.cache/
node_modules/
*.log

# data：目录结构保留（.gitkeep 占位），文件不入库
data/uploads/*
!data/uploads/.gitkeep
data/trash/*
!data/trash/.gitkeep
data/tasks/state.json
data/tasks/records.jsonl
data/refs.json

# 调试出图产物（体积大，且运行时不依赖；refs 参考图保留）
_dev/prompt_lab/out/
_dev/prompt_lab/board/out/
_dev/*.log

# 冒烟测试产物（代码与文档均未引用）
_dev/smoke/

# 无引用的大体积参考数据
_reference/oi_all.json
